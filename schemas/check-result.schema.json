            },
            "outcomes": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "successful",
                  "failed",
                  "aborted",
                  "skipped"
                ]
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "maxPoints": {
          "type": "number",
          "minimum": 0
        },
        "rawResult": {
          "type": "object",
          "properties": {
            "score": {
