{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afonenko-course-tools.github.io/prairielearn-platform/schemas/check-result.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": [
        "declared",
        "delivery"
      ]
    },
    "qualifiedId": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "sourceSnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventoryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deliveryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime": {
      "type": "string"
    },
    "imageDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "testsHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "gradable": {
      "type": "boolean"
    },
    "grading_error": {
      "type": "boolean"
    },
    "studentCompilation": {
      "enum": [
        "success",
        "failure",
        "not-run"
      ]
    },
    "trustedCompilation": {
      "enum": [
        "success",
        "failure",
        "not-run"
      ]
    },
    "infrastructure": {
      "enum": [
        "complete",
        "failure"
      ]
    },
    "classification": {
      "enum": [
        "success",
        "behavior-failure",
        "student-compilation-failure",
        "student-test-quality-failure",
        "student-timeout",
        "student-output-overflow",
        "unsafe-submission",
        "infrastructure-failure"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "discovered": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "aborted": {
          "type": "integer",
          "minimum": 0
        },
        "containerFailures": {
          "type": "integer",
          "minimum": 0
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "successful",
              "failed",
              "aborted",
              "skipped"
            ]
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "score": {
      "type": "number",
      "minimum": 0
    },
    "maxPoints": {
      "type": "number",
      "minimum": 0
    },
    "rawResult": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0
        },
        "points": {
          "type": "number",
          "minimum": 0
        },
        "max_points": {
          "type": "number",
          "minimum": 0
        },
        "output": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "gradable": {
          "type": "boolean"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "points": {
                "type": "number",
                "minimum": 0
              },
              "max_points": {
                "type": "number",
                "minimum": 0
              },
              "message": {
                "type": "string"
              },
              "output": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "points",
              "max_points"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "durations": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "toolchain": {
      "type": "string"
    },
    "scoring": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "weighted"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "all-pass"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "contract-groups"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "tests": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "weight",
                  "tests"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "mode",
            "groups"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "threshold"
            },
            "basis": {
              "enum": [
                "score",
                "passed-tests"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "mode",
            "basis",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "output": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "format_errors": {
      "type": "string"
    },
    "timed_out": {
      "type": "boolean"
    },
    "output_limited": {
      "type": "boolean"
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/outcome"
      }
    },
    "backend": {
      "enum": [
        "host",
        "container"
      ]
    },
    "publicResult": {
      "$ref": "#/$defs/outcome"
    },
    "containment": {
      "enum": [
        "official-landlock-sbuser",
        "host-diagnostic"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "qualifiedId",
    "scenario",
    "sourceSnapshotHash",
    "inventoryHash",
    "runtime",
    "infrastructure",
    "classification"
  ],
  "additionalProperties": false,
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gradable": {
          "type": "boolean"
        },
        "grading_error": {
          "type": "boolean"
        },
        "studentCompilation": {
          "enum": [
            "success",
            "failure",
            "not-run"
          ]
        },
        "trustedCompilation": {
          "enum": [
            "success",
            "failure",
            "not-run"
          ]
        },
        "infrastructure": {
          "enum": [
