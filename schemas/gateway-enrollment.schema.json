{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-enrollment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "userUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "instance": {
      "type": "string",
      "minLength": 1
    },
    "courseKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "role": {
      "type": "string",
      "enum": ["student", "teacher"]
    },
    "email": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 254,
          "pattern": "^(?=[^@]{1,64}@)(?!\\.)(?![^@]*\\.\\.)(?![^@]*\\.@)[a-z0-9!#$%&'*+/=?^_`{|}~.\\-]+@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?![\\s\\S])"
        }
      ]
    }
  },
  "required": ["userUid", "instance", "courseKey", "role", "email"]
}
