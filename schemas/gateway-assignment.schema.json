{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "userUid": {
      "type": "string",
      "minLength": 1
    },
    "instance": {
      "type": "string",
      "minLength": 1
    },
    "courseKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "oldWork": {
      "type": [
        "string",
        "null"
      ]
    },
    "newWork": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "version",
    "userUid",
    "instance",
    "courseKey",
    "oldWork",
    "newWork"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-assignment.schema.json"
}
