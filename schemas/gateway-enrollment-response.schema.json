{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-enrollment-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "userUid": { "type": "string", "minLength": 1, "maxLength": 512 },
    "instance": { "type": "string", "minLength": 1 },
    "courseKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "enrolled": { "const": true },
    "path": { "type": "string", "pattern": "^/pl/course_instance/[1-9][0-9]*/assessments(?![\\s\\S])" }
  },
  "required": ["schemaVersion", "userUid", "instance", "courseKey", "enrolled", "path"]
}
