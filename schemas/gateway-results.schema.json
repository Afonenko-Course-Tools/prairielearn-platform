{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "source": {
      "const": "per-slot-results-v2"
    },
    "assignmentId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "userUid": {
      "type": "string",
      "minLength": 1
    },
    "instance": {
      "type": "string",
      "minLength": 1
    },
    "deliveryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workId": {
      "type": "string",
      "minLength": 1
    },
    "currentAttempt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "number": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id",
            "number"
          ]
        }
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completedRequired": {
          "type": "integer",
          "minimum": 0
        },
        "requiredCount": {
          "type": "integer",
          "minimum": 1
        },
        "atLeast": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "completedRequired",
        "requiredCount",
        "atLeast",
        "passed"
      ]
    },
    "state": {
      "enum": [
        "started",
        "not-started"
      ]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "qualifiedId": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "points": {
            "type": [
              "number",
              "null"
            ]
          },
          "maxPoints": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "enum": [
              "complete",
              "grading",
              "unanswered"
            ]
          },
          "slotId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "qualifiedId",
          "score",
          "points",
          "maxPoints",
          "status",
          "slotId"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "assignmentId",
    "version",
    "userUid",
    "instance",
    "deliveryHash",
    "workId",
    "currentAttempt",
    "slots",
    "completion",
    "state"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-results.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "not-started"
          }
        }
      },
      "then": {
        "properties": {
          "currentAttempt": {
            "type": "null"
          },
          "slots": {
            "maxItems": 0
          },
          "completion": {
            "properties": {
              "completedRequired": {
                "const": 0
              },
              "passed": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "currentAttempt": {
            "type": "object"
          },
          "slots": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
