{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afonenko-course-tools.github.io/prairielearn-platform/schemas/project-check.schema.json",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string"
    },
    "source-profile": {
      "type": "string"
    },
    "sourceProfile": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "implementation",
            "student-tests"
          ]
        },
        "root": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "mode",
        "root",
        "include"
      ],
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "implementation",
        "student-tests"
      ]
    },
    "runtime": {
      "enum": [
        "java25-junit-v1",
        "java25-mutation-v1",
        "fish-git-v1",
        "java25-gradle-junit-v1"
      ]
    },
    "java": {
      "type": "object",
      "properties": {
        "release": {
          "const": 25
        },
        "encoding": {
          "const": "UTF-8"
        },
        "compiler-options": {
          "const": [
            "-proc:none",
            "-Xmaxerrs",
            "5"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "outer-seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "compile-seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "run-seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "networking": {
          "const": false
        },
        "max-output-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scoring": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "weighted"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "all-pass"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "contract-groups"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "tests": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "weight",
                  "tests"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "mode",
            "groups"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "threshold"
            },
            "basis": {
              "enum": [
                "score",
                "passed-tests"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "mode",
            "basis",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "discovery": {
      "type": "object",
      "properties": {
        "min-executed": {
          "type": "integer",
          "minimum": 1
        },
        "allow-skipped": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "root"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
      },
      "minItems": 0
    },
    "verification-tests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
      },
      "minItems": 0
    },
    "contract-cases": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
    },
    "verification-expectations": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "object",
          "properties": {
            "student-compilation": {
              "enum": [
                "success",
                "failure"
              ]
            },
            "job": {
              "enum": [
                "complete",
                "failure"
              ]
            },
            "classification": {
              "enum": [
                "success",
                "behavior-failure",
                "student-compilation-failure",
                "student-test-quality-failure",
                "student-timeout",
                "student-output-overflow",
                "unsafe-submission",
                "infrastructure-failure",
                "student-api-mismatch"
              ]
            },
            "required-tests": {
              "const": "all-pass"
            },
            "failed-tests": {
              "type": "object",
              "properties": {
                "at-least": {
                  "type": "integer",
                  "minimum": 0
                },
                "exactly": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "executed-tests": {
              "type": "object",
              "properties": {
                "at-least": {
                  "type": "integer",
                  "minimum": 0
                },
                "exactly": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "test-ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "score": {
              "type": "object",
              "properties": {
                "less-than": {
                  "type": "number",
                  "minimum": 0
                },
                "at-least": {
                  "type": "number",
                  "minimum": 0
                },
                "exactly": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "starter": {
          "type": "object",
          "properties": {
            "student-compilation": {
              "enum": [
                "success",
                "failure"
              ]
            },
            "job": {
              "enum": [
                "complete",
                "failure"
              ]
            },
            "classification": {
              "enum": [
                "success",
                "behavior-failure",
                "student-compilation-failure",
                "student-test-quality-failure",
                "student-timeout",
                "student-output-overflow",
                "unsafe-submission",
                "infrastructure-failure",
                "student-api-mismatch"
              ]
            },
            "required-tests": {
              "const": "all-pass"
            },
            "failed-tests": {
              "type": "object",
              "properties": {
                "at-least": {
                  "type": "integer",
                  "minimum": 0
                },
                "exactly": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "executed-tests": {
              "type": "object",
              "properties": {
                "at-least": {
                  "type": "integer",
                  "minimum": 0
                },
                "exactly": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "test-ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "score": {
              "type": "object",
              "properties": {
                "less-than": {
                  "type": "number",
                  "minimum": 0
                },
                "at-least": {
                  "type": "number",
                  "minimum": 0
                },
                "exactly": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "properties": {
        "correct": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "mutants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "correct",
        "mutants"
      ],
      "additionalProperties": false
    },
    "api-precheck": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+\\.java$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*$"
        }
      },
      "required": [
        "files",
        "entry"
      ],
      "additionalProperties": false
    },
    "verification-api-precheck": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+\\.java$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*$"
        }
      },
      "required": [
        "files",
        "entry"
      ],
      "additionalProperties": false
    },
    "additional-java-sources": {
      "type": "object",
      "properties": {
        "primary-required": {
          "type": "boolean"
        },
        "archive": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}\\.zip$"
        },
        "max-files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max-file-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max-total-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "max-archive-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      },
      "required": [
        "archive",
        "max-files",
        "max-file-bytes",
        "max-total-bytes",
        "max-archive-bytes"
      ],
      "additionalProperties": false
    },
    "public-cases": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "test": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "input": {
            "type": "string",
            "minLength": 0,
            "maxLength": 8192
          },
          "state": {
            "type": "string",
            "minLength": 0,
            "maxLength": 8192
          },
          "action": {
            "type": "string",
            "minLength": 0,
            "maxLength": 8192
          },
          "expected": {
            "type": "string",
            "minLength": 0,
            "maxLength": 8192
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "test",
          "expected",
          "name"
        ],
        "anyOf": [
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "action"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "feedback": {
      "type": "object",
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "what-check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "requirement",
        "what-check"
      ],
      "additionalProperties": false
    },
    "java-build": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "gradle-jar-v1"
        },
        "artifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}\\.jar$"
        },
        "main-class": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$(?![\\s\\S])"
        }
      },
      "required": [
        "kind",
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "runtime"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "api-precheck"
            ]
          },
          {
            "required": [
              "verification-api-precheck"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "runtime": {
            "enum": [
              "java25-junit-v1",
              "java25-gradle-junit-v1"
            ]
          },
          "mode": {
            "const": "implementation"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "additional-java-sources"
        ]
      },
      "then": {
        "properties": {
          "runtime": {
            "enum": [
              "java25-junit-v1",
              "java25-gradle-junit-v1"
            ]
          },
          "sourceProfile": {
            "properties": {
              "mode": {
                "const": "implementation"
              }
            }
          },
          "mode": {
            "const": "implementation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "java25-gradle-junit-v1"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "java-build",
          "sourceProfile"
        ],
        "properties": {
          "mode": {
            "const": "implementation"
          },
          "sourceProfile": {
            "properties": {
              "mode": {
                "const": "implementation"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "java-build"
          ]
        }
      }
    }
  ]
}
