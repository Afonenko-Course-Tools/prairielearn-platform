{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afonenko-course-tools.github.io/prairielearn-platform/schemas/published-runtime-profiles-v2.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "workspaceImages": {
      "type": "object",
      "properties": {
        "sp-git-workspace-v1": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^ghcr\\.io/[a-z0-9-]+/sp-git-workspace@sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "image"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "profiles",
    "workspaceImages"
  ],
  "additionalProperties": false
}
