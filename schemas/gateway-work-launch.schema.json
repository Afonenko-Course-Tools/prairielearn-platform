{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-work-launch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workId": {
      "type": "string",
      "minLength": 1
    },
    "userUid": {
      "type": "string",
      "minLength": 1
    },
    "instance": {
      "type": "string",
      "minLength": 1
    },
    "deliveryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/pl/course_instance/[1-9][0-9]*/assessment/[1-9][0-9]*/$"
    }
  },
  "required": [
    "workId",
    "userUid",
    "instance",
    "deliveryHash",
    "path"
  ]
}
