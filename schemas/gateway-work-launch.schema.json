{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway-work-launch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workId": {
      "type": "string",
      "minLength": 1
    },
    "userUid": {
      "type": "string",
      "minLength": 1
    },
    "instance": {
      "type": "string",
      "minLength": 1
    },
    "courseKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^/pl/course_instance/[1-9][0-9]*/assessment/[1-9][0-9]*/$"
    }
  },
  "required": [
    "workId",
    "userUid",
    "instance",
    "courseKey",
    "path"
  ]
}
