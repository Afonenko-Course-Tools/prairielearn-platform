{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "bridge/**/*.mjs",
    "tools/**/*.mjs",
    "tests/**/*.mjs",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "tests/fixtures"]
}
